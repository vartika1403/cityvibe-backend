# Local values for running the prod profile on this machine.
# Git-ignored (matches *.env in .gitignore) — never commit real credentials.
#
# These point at the same local MySQL the dev profile uses, so the prod
# profile can be exercised locally. The real production values live in the
# Railway dashboard (see DEPLOYMENT.md), not in this file.
#
# Usage:
#   set -a && source prod.env && set +a
#   mvn spring-boot:run -Dspring-boot.run.profiles=prod

DB_URL="jdbc:mysql://localhost:3306/cityvibe?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
DB_USERNAME="cityvibe"
DB_PASSWORD="cityvibe123"

# Optional in prod — blank values are tolerated, the features fail closed.
# TICKETMASTER_API_KEY=""
SERPAPI_API_KEY="c7fdd9f6eacb39924bd22a59873e1b73fc8244d372d5a9bb9906f41c3f52d0db"
ADMIN_SEED_TOKEN="f599e31d5b83ec58df32c75acaf44f1e00aea0e739c3fa4a6f2a10d85ec491ad"
CORS_ALLOWED_ORIGINS="*"
