# Local values for running the prod profile on this machine.
#
# NOTE: this file is tracked in git despite the *.env rule in .gitignore, which
# only applies to untracked files. The keys below are therefore in the repo
# history and readable by anyone with access to it.
#
# Loaded automatically by application-prod.properties via spring.config.import,
# so no shell setup is needed: running with the prod profile from a terminal or
# from the IDE picks these up. In real production this file is absent and the
# import is skipped (it is marked optional); Railway supplies the values as
# environment variables instead — see DEPLOYMENT.md.
#
# Java .properties format: no quotes, no `export`. Values run to end of line,
# so an unquoted & is fine here (but would break `source` in a shell).

DB_URL=jdbc:mysql://localhost:3306/cityvibe?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=cityvibe
DB_PASSWORD=cityvibe123

SERPAPI_API_KEY=c7fdd9f6eacb39924bd22a59873e1b73fc8244d372d5a9bb9906f41c3f52d0db
ADMIN_SEED_TOKEN=f599e31d5b83ec58df32c75acaf44f1e00aea0e739c3fa4a6f2a10d85ec491ad

CORS_ALLOWED_ORIGINS=*
